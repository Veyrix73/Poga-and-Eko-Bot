# Create an application at https://discord.com/developers/applications
DISCORD_TOKEN=replace_with_your_bot_token
DISCORD_CLIENT_ID=replace_with_your_application_id

# Optional: commands appear immediately in this development server.
# Leave blank to register globally (global propagation can take longer).
DISCORD_GUILD_ID=

# Optional text channels; blank disables that destination/feature.
WELCOME_CHANNEL_ID=
SUGGESTIONS_CHANNEL_ID=
REPORT_CHANNEL_ID=

# Default timezone for stream schedules (the schedule can override this).
TIMEZONE=Europe/Riga
DATA_DIR=data
